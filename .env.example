# Copy to .env for local development. All variables are optional.
# Set the same variables in Netlify → Site configuration → Environment variables.

# Contact route shown in "Have a question worth exploring together?".
# With an address set, the button is a mailto link whose subject carries the
# question the reader was on. Leave empty to link to
# https://www.richallen.info/lets-talk instead.
PUBLIC_CONTACT_EMAIL=

# Privacy-conscious analytics. One of: none | plausible | umami | goatcounter
# Leave as "none" (or unset) to ship no analytics script at all.
PUBLIC_ANALYTICS_PROVIDER=none

# plausible:   the domain registered in Plausible, e.g. questions.richallen.info
# umami:       the website id from Umami
# goatcounter: your GoatCounter code, e.g. "richallen" for richallen.goatcounter.com
PUBLIC_ANALYTICS_ID=

# Optional: self-hosted script origin (plausible/umami). Defaults to the
# provider's hosted endpoint when empty.
PUBLIC_ANALYTICS_HOST=
