---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Progress from '@/components/Progress.astro';
import QuestionIndex from '@/components/QuestionIndex.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import { site } from '@/lib/site';
import { getQuestions } from '@/lib/questions';

const questions = await getQuestions();
const count = questions.length;
const countWord = ['zero','one','two','three','four','five','six','seven','eight','nine','ten'][count] ?? String(count);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: site.author.name, url: site.author.links.website.url },
};
---
<BaseLayout title={site.name} description={site.description} path="/" schema={schema}>
  <SiteHeader variant="masthead">
    <Progress questions={questions} labels />
  </SiteHeader>

  <main id="main">
    <section class="intro wrap">
      <div class="intro__grid">
        <p class="meta meta--muted reveal" style="--i:2">Introduction</p>
        <div class="intro__text reveal" style="--i:3">
          <p class="intro__lede lede">Sometimes the most useful thing we can do is challenge the question we’re asking.</p>
          <p class="intro__body">Explore {countWord} questions about how organisations work, how value flows, and what might be getting in the way. Each one stands on its own. Start wherever your attention lands.</p>
        </div>
      </div>
    </section>

    <section class="collection wrap" aria-labelledby="collection-heading">
      <hr class="rule" />
      <div class="collection__head meta">
        <h2 id="collection-heading" class="meta"><span class="accent">The questions</span><span class="sep" aria-hidden="true">·</span>No. 01–{String(count).padStart(2, '0')}</h2>
        <span class="meta meta--muted">{site.collectionLabel}</span>
      </div>
      <QuestionIndex questions={questions} />
    </section>

    <section class="wrap wrap--narrow tail">
      <About />
      <Contact />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .intro { padding-block: var(--space-4) var(--space-5); }
  .intro__grid { display: grid; gap: var(--space-2); }
  .intro__text { display: grid; gap: var(--space-2); max-width: var(--measure); }
  .intro__lede { font-size: var(--step-2); line-height: 1.25; letter-spacing: -0.01em; }
  .intro__body { color: var(--ink-2); font-size: var(--step-0); }
  .collection__head { display: flex; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; padding: 0.9rem 0 var(--space-4); }
  .tail { margin-top: var(--space-5); }
  @media (min-width: 720px) {
    .intro { padding-block: var(--space-5) var(--space-6); }
    .intro__grid { grid-template-columns: 11rem 1fr; gap: var(--space-3); }
    .intro__lede { font-size: var(--step-3); }
  }
</style>
