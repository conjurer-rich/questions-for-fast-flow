---
import { site } from '@/lib/site';
import Wordmark from '@/components/Wordmark.astro';
interface Props { current?: string }
const { current } = Astro.props;
const isHome = current === '/';
---
<header class="site-header">
  <div class="wrap site-header__inner">
    {isHome ? (
      <span class="site-header__brand" aria-current="page"><Wordmark /></span>
    ) : (
      <a class="site-header__brand" href="/" aria-label={`${site.name} — all questions`}><Wordmark /></a>
    )}
    <slot />
  </div>
</header>

<style>
  .site-header { padding-block: var(--space-3); }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
  }
  .site-header__brand {
    display: inline-flex; align-items: center; gap: 0.6em;
    text-decoration: none; color: var(--ink);
    font-family: var(--serif); font-variation-settings: 'SOFT' 60;
    font-size: var(--step-0); font-weight: 500; letter-spacing: -0.01em;
  }
  a.site-header__brand:hover { color: var(--accent); }
</style>
