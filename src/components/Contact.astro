---
/** A subtle invitation to continue the conversation. */
import { site } from '@/lib/site';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { contact, author } = site;
const href = contact.email ? `mailto:${contact.email}?subject=${encodeURIComponent('A question worth exploring')}` : author.links.website.url;
const label = contact.email ? 'Start a conversation' : `Get in touch via ${author.links.website.label}`;
---
<section class="contact" aria-labelledby="contact-heading">
  <hr class="rule" />
  <div class="contact__grid">
    <p class="meta meta--muted">Continue the conversation</p>
    <div class="contact__text">
      <Heading id="contact-heading" class="contact__heading display">{contact.heading}</Heading>
      <p class="contact__body">“{contact.body}”</p>
      <p class="contact__action">
        <a class="btn" href={href} rel={contact.email ? undefined : 'noopener'} data-track="contact" data-track-to={contact.email ? 'email' : 'richallen.info'}>
          {label}
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
        <span class="contact__by meta meta--muted">— {author.name}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: var(--space-3) var(--space-4); }
  .contact__grid { display: grid; gap: var(--space-2); padding-top: var(--space-3); }
  .contact__text { display: grid; gap: var(--space-2); max-width: var(--measure); }
  .contact__heading { font-size: var(--step-3); line-height: 1.05; }
  .contact__body { color: var(--ink-2); font-size: var(--step-1); line-height: 1.4; text-wrap: pretty; }
  .contact__action { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-1); }
  @media (min-width: 720px) {
    .contact__grid { grid-template-columns: 11rem 1fr; gap: var(--space-3); }
  }
</style>
