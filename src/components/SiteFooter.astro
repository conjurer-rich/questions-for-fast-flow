---
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__collection serif">{site.collectionLabel}</p>
    <p class="site-footer__meta">
      <span>© {year} {site.author.name}</span>
      <span aria-hidden="true"> · </span>
      <a href={site.author.links.website.url} rel="me noopener">{site.author.links.website.label}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-5); padding-block: var(--space-4); border-top: 1px solid var(--rule); }
  .site-footer__inner { display: flex; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; align-items: baseline; }
  .site-footer__collection { color: var(--ink-2); font-style: italic; font-size: var(--step-0); }
  .site-footer__meta { color: var(--ink-3); font-size: var(--step--1); }
</style>
