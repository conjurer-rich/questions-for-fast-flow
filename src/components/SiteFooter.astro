---
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <hr class="rule" />
    <div class="site-footer__inner meta meta--muted">
      <span class="site-footer__collection">{site.collectionLabel}</span>
      <span>© {year} {site.author.name}<span class="sep" aria-hidden="true">·</span><a href={site.author.links.website.url} rel="me noopener">{site.author.links.website.label}</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-4); padding-bottom: var(--space-4); }
  .site-footer__inner { display: flex; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; padding-top: 0.9rem; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--accent); }
</style>
