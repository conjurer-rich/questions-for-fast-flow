---
import { pad } from '@/lib/site';
import type { Question } from '@/lib/questions';
interface Props { next: Question; prev: Question }
const { next, prev } = Astro.props;
---
<nav class="next-question" aria-label="Continue to another question">
  <p class="eyebrow">Explore another question</p>
  <a class="next-question__card" href={`/${next.id}`} data-accent={next.data.accent} data-track="question_next" data-track-to={next.id} rel="next">
    <span class="next-question__spine" aria-hidden="true"></span>
    <span class="next-question__meta eyebrow"><span class="visually-hidden">Question </span><span class="num">{pad(next.data.number)}</span><span aria-hidden="true"> · </span>{next.data.category}</span>
    <span class="next-question__q display">{next.data.question}</span>
    <span class="next-question__cta arrow-link">Next question <span class="arrow" aria-hidden="true">→</span></span>
  </a>
  <p class="next-question__links">
    <a href={`/${prev.id}`} rel="prev" data-track="question_prev" data-track-to={prev.id}><span aria-hidden="true">← </span>Previous: {pad(prev.data.number)} {prev.data.category}</a>
    <a href="/" data-track="question_index">All five questions</a>
  </p>
</nav>

<style>
  .next-question { margin-block: var(--space-5); display: grid; gap: var(--space-2); }
  .next-question__card {
    position: relative; display: grid; gap: 0.6rem;
    padding: var(--space-3) var(--space-3) var(--space-3) calc(var(--space-3) + 6px);
    background: var(--surface);
    border: 1px solid var(--rule); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    text-decoration: none; color: var(--ink); overflow: hidden;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .next-question__card:hover, .next-question__card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--rule));
    box-shadow: 0 1px 0 rgba(27,25,21,.06), 0 18px 40px -20px rgba(27,25,21,.45);
  }
  .next-question__card:hover .arrow { transform: translateX(0.25em); }
  .next-question__spine { position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--accent); }
  .next-question__q { font-size: var(--step-2); line-height: 1.12; }
  .next-question__cta { color: var(--accent); font-size: var(--step--1); }
  .next-question__links {
    display: flex; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap;
    font-size: var(--step--1); color: var(--ink-2);
  }
  @media (min-width: 720px) {
    .next-question__card { padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 6px); }
    .next-question__q { font-size: var(--step-3); }
  }
</style>
