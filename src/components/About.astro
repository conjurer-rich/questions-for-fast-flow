---
/**
 * A short, understated introduction to the person behind the questions.
 * `compact` is used on question pages; the full version on the homepage.
 */
import { site } from '@/lib/site';
interface Props { compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { compact = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { author } = site;
---
<section class="about" aria-labelledby="about-heading">
  <div class="about__grid">
    <div class="about__mark" aria-hidden="true">
      <span class="about__initials serif">RA</span>
    </div>
    <div class="about__text">
      <p class="eyebrow">About the author</p>
      <Heading id="about-heading" class="about__name serif">{author.name}</Heading>
      <p class="about__role">{author.role}</p>
      <div class="about__bio">
        {compact ? <p>{author.bio[0]} {author.bio[1]}</p> : author.bio.map((p) => <p>{p}</p>)}
      </div>
      <ul role="list" class="about__links">
        <li><a href={author.links.website.url} rel="me noopener" data-track="outbound" data-track-to="richallen.info">{author.links.website.label}<span aria-hidden="true"> ↗</span></a></li>
        <li><a href={author.links.userNeedsMapping.url} rel="noopener" data-track="outbound" data-track-to="userneedsmapping.com">{author.links.userNeedsMapping.label}<span aria-hidden="true"> ↗</span></a></li>
        <li><a href={author.links.fastFlowToolkit.url} rel="noopener" data-track="outbound" data-track-to="fastflowtoolkit.com">{author.links.fastFlowToolkit.label}<span aria-hidden="true"> ↗</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { padding-block: var(--space-4); border-top: 1px solid var(--rule); }
  .about__grid { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .about__mark {
    width: 3.5rem; height: 3.5rem; border-radius: 999px;
    display: grid; place-items: center;
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--rule));
    color: var(--accent);
  }
  .about__initials { font-size: 1.1rem; font-weight: 500; letter-spacing: 0.02em; }
  .about__text { display: grid; gap: 0.5rem; max-width: var(--measure); }
  .about__name { font-size: var(--step-2); font-weight: 500; letter-spacing: -0.01em; line-height: 1.1; }
  .about__role { color: var(--ink-3); font-size: var(--step--1); margin-top: -0.25rem; }
  .about__bio { color: var(--ink-2); text-wrap: pretty; }
  .about__bio p + p { margin-top: 0.8em; }
  .about__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 0.5rem; font-size: var(--step--1); font-weight: 500; }
  .about__links a { text-decoration-color: var(--rule-strong); }
  .about__links a:hover { color: var(--accent); text-decoration-color: currentColor; }
  @media (max-width: 480px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__mark { width: 3rem; height: 3rem; }
  }
</style>
